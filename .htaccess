<IfModule mod_rewrite.c>
    RewriteEngine On

    # 機密ファイルへのアクセスをブロック
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.env\..*$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^phpunit\.xml$ - [F,L]

    # 機密ディレクトリへのアクセスをブロック
    RewriteRule ^app/.*$ - [F,L]
    RewriteRule ^bootstrap/.*$ - [F,L]
    RewriteRule ^config/.*$ - [F,L]
    RewriteRule ^database/.*$ - [F,L]
    RewriteRule ^resources/.*$ - [F,L]
    RewriteRule ^routes/.*$ - [F,L]
    RewriteRule ^storage/.*$ - [F,L]
    RewriteRule ^tests/.*$ - [F,L]
    RewriteRule ^vendor/.*$ - [F,L]
    RewriteRule ^node_modules/.*$ - [F,L]

    # /public/で始まるリクエストの場合、public/ディレクトリ内のパスにリライト
    # これにより、public/.htaccessのルール（index.phpへのリライト）が適用される
    RewriteCond %{REQUEST_URI} ^/public/(.*)$
    RewriteRule ^.*$ public/%1 [E=DEBUG_ROOT_REWRITE:rewritten_to_public,L]

    # 既存のファイルやディレクトリでない場合、/public/にリライト
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

# 機密ファイルへのアクセスをブロック（FilesMatchディレクティブも使用）
<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# .envファイルを明示的にブロック
<Files ".env">
    Order deny,allow
    Deny from all
</Files>
<FilesMatch "^\.env\.">
    Order deny,allow
    Deny from all
</FilesMatch>
